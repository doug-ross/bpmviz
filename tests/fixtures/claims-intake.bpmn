<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_Claims" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_Insurer" name="Insurer" processRef="Process_Claims" />
    <bpmn:participant id="Pool_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:messageFlow id="Msg_1" sourceRef="Pool_Customer" targetRef="Start_Claim" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Claims" name="Motor claims intake" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Intake" name="Claims intake">
        <bpmn:flowNodeRef>Start_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Chase</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Handler" name="Claims handler">
        <bpmn:flowNodeRef>Split_Checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coverage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Settled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Systems" name="Claims system">
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Claim" name="Claim notified"><bpmn:messageEventDefinition /></bpmn:startEvent>
    <bpmn:userTask id="Task_Register" name="Register claim"><bpmn:documentation>Capture policy, loss date and contact details.</bpmn:documentation></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_Complete" name="Documents complete?" default="Flow_Complete" />
    <bpmn:userTask id="Task_RequestDocs" name="Request missing documents" />
    <bpmn:boundaryEvent id="Timer_Chase" name="Chase after 5 days" attachedToRef="Task_RequestDocs"><bpmn:timerEventDefinition /></bpmn:boundaryEvent>
    <bpmn:parallelGateway id="Split_Checks" />
    <bpmn:businessRuleTask id="Task_Coverage" name="Check coverage" />
    <bpmn:userTask id="Task_Fraud" name="Review fraud indicators" />
    <bpmn:serviceTask id="Task_Score" name="Score claim risk" />
    <bpmn:parallelGateway id="Join_Checks" />
    <bpmn:subProcess id="Sub_Settle" name="Settle claim">
      <bpmn:startEvent id="Sub_Start" />
      <bpmn:task id="Sub_Pay" name="Pay claimant" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Settled" name="Claim settled" />
    <bpmn:dataObjectReference id="Data_Form" name="Claim form" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Claim" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Register" targetRef="Gate_Complete" />
    <bpmn:sequenceFlow id="Flow_Missing" name="Missing" sourceRef="Gate_Complete" targetRef="Task_RequestDocs"><bpmn:conditionExpression>missing</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Back" sourceRef="Task_RequestDocs" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_Complete" name="Complete" sourceRef="Gate_Complete" targetRef="Split_Checks" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Split_Checks" targetRef="Task_Coverage" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Split_Checks" targetRef="Task_Fraud" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Split_Checks" targetRef="Task_Score" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Coverage" targetRef="Join_Checks" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Fraud" targetRef="Join_Checks" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Score" targetRef="Join_Checks" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Join_Checks" targetRef="Sub_Settle" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Sub_Settle" targetRef="End_Settled" />
  </bpmn:process>
  <bpmn:process id="Process_Customer" name="Customer" />
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="S_Lane_Intake" bpmnElement="Lane_Intake"><dc:Bounds x="120" y="80" width="1400" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Handler" bpmnElement="Lane_Handler"><dc:Bounds x="120" y="230" width="1400" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Systems" bpmnElement="Lane_Systems"><dc:Bounds x="120" y="380" width="1400" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start_Claim"><dc:Bounds x="170" y="137" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Register" bpmnElement="Task_Register"><dc:Bounds x="260" y="115" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gate" bpmnElement="Gate_Complete"><dc:Bounds x="420" y="130" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Request" bpmnElement="Task_RequestDocs"><dc:Bounds x="530" y="115" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Timer" bpmnElement="Timer_Chase"><dc:Bounds x="592" y="177" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Split" bpmnElement="Split_Checks"><dc:Bounds x="700" y="280" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Coverage" bpmnElement="Task_Coverage"><dc:Bounds x="810" y="240" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Fraud" bpmnElement="Task_Fraud"><dc:Bounds x="810" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Score" bpmnElement="Task_Score"><dc:Bounds x="810" y="415" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Join" bpmnElement="Join_Checks"><dc:Bounds x="970" y="280" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Settle" bpmnElement="Sub_Settle"><dc:Bounds x="1080" y="265" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End" bpmnElement="End_Settled"><dc:Bounds x="1250" y="287" width="36" height="36" /></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
